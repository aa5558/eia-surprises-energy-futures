# Copy to .env and fill in. Never commit .env.

# Optional. Keyless EIA Excel downloads are the default data path.
EIA_API_KEY=

# Required only after the Databento data budget is approved.
DATABENTO_API_KEY=

# Leave unset. Set to the frozen-spec git tag only for the single locked-test run (see docs/02_*).
TEQ_UNLOCK_TEST=
